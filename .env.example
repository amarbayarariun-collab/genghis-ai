# Optional — without a key the app runs in mock/demo mode.
# Prefer OPENAI_API_KEY. Febbas currently injects the secret as `AP`
# (xAI keys start with xai- and auto-route to api.x.ai).
OPENAI_API_KEY=
# AP=

# Optional OpenAI-compatible overrides (auto-set for xai- keys if unset)
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-4.3

# Image provider: auto (default) | openai | xai
# - auto: try OPENAI_IMAGE_API_KEY first; on missing/fail use xAI chat key (AP)
# - xai: only existing xAI key → https://api.x.ai/v1 , model grok-imagine-image
# - openai: only OPENAI_IMAGE_API_KEY → https://api.openai.com/v1
# IMAGE_PROVIDER=xai

# Optional dedicated OpenAI key for /api/image (GPT Image). When set (and
# IMAGE_PROVIDER is auto/openai), images use https://api.openai.com/v1.
# OPENAI_IMAGE_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# For xAI Imagine, OPENAI_IMAGE_MODEL may be grok-imagine-image (~$0.02).


