# Optional — without a chat backend the app runs in mock/demo mode.
# Prefer OPENAI_API_KEY. Febbas currently injects the secret as `AP`
# (xAI keys start with xai- and auto-route to api.x.ai).
OPENAI_API_KEY=
# AP=

# Optional OpenAI-compatible overrides (auto-set for xai- keys if unset)
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-4.3

# Chat provider abstraction (preferred for self-hosted cutover).
# CHAT_PROVIDER=xai | openai | self
# CHAT_BASE_URL=https://api.x.ai/v1
# CHAT_MODEL=            # ops override; otherwise plan picks grok-4.3 (free) / grok-4.7 (paid)
# CHAT_API_KEY=
# Example self-hosted (vLLM / Ollama OpenAI-compatible):
# CHAT_PROVIDER=self
# CHAT_BASE_URL=http://127.0.0.1:8000/v1
# CHAT_MODEL=genghis-mn
# CHAT_API_KEY=  # optional on trusted local networks

# Cost controls (chat path)
# CHAT_HISTORY_LIMIT=16
# CHAT_MAX_TOKENS=1500
# ATTACH_TEXT_LIMIT=15000

# Admin-only estimated USD rates per 1M tokens (not billing)
# XAI_USD_PER_MTOK_INPUT=3
# XAI_USD_PER_MTOK_OUTPUT=15
# XAI_USD_PER_MTOK_CACHED_INPUT=0.75
# XAI_USD_PER_MTOK_REASONING=15

# Optional dedicated OpenAI key for /api/image (DALL·E). When set, images use
# https://api.openai.com/v1 and ignore the chat/xAI key above.
# OPENAI_IMAGE_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=dall-e-3

# --- Signup + usage tracking (90-day lean) ---
# Neon / Postgres connection string (required for durable users + counters).
# Without it, auth still works in-process memory (dev only; resets on cold start).
# DATABASE_URL=postgresql://...

# Sign session cookies (required in production).
# AUTH_SECRET=long-random-string

# Public site URL for Google OAuth redirects (and local absolute links).
# AUTH_URL=https://genghis-ai-delta.vercel.app

# Owner admin gate for /admin (and /api/admin/stats).
# ADMIN_SECRET=long-random-string

# Optional Google signup
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google Cloud Console → OAuth client → Authorized redirect URI:
#   https://YOUR_DOMAIN/api/auth/google/callback
