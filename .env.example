# Optional — without a key the app runs in mock/demo mode.
# Prefer OPENAI_API_KEY. Febbas currently injects the secret as `AP`
# (xAI keys start with xai- and auto-route to api.x.ai).
OPENAI_API_KEY=
# AP=

# Optional OpenAI-compatible overrides (auto-set for xai- keys if unset)
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-4.3

# Image provider: auto (default when unset) | openai | xai
# - auto / unset: PRIMARY xAI grok-imagine-image via AP / OPENAI_API_KEY (xai-…)
# - openai: OpenAI GPT Image only (explicit opt-in)
# - xai: xAI Imagine only
# IMAGE_PROVIDER=auto

# PRIMARY — xAI Imagine uses the chat key above (AP / OPENAI_API_KEY with xai-…).
# Model: grok-imagine-image (~$0.02). Retired grok-2-image* are skipped.

# OPT-IN FALLBACK — dedicated OpenAI key for /api/image (GPT Image).
# Only used when IMAGE_PROVIDER=openai, or as auto fallback when this key is set.
# OPENAI_IMAGE_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Cost control defaults:
# OPENAI_IMAGE_QUALITY=low
# OPENAI_IMAGE_SIZE=1024x1024

# A real OpenAI OPENAI_API_KEY (sk-…, not xai-) may also opt in OpenAI images.
# The xAI key mapped into OPENAI_API_KEY / AP is never treated as OpenAI.
